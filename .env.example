# Copy to .env.local and fill with your Firebase web app config.
# Firebase -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# These values are NOT secrets (security is enforced by firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# seeder / maintenance scripts
#   node tools/seed.mjs          (needs an admin account email+password)
# You can use EITHER the web API key (used with Firebase Auth REST sign-in)
SEED_API_KEY=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# ...or, preferably, a service-account key file path for the scripts:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json